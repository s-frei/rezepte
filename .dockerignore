# An allowlist, not a denylist. A denylist needs someone to remember the new
# directory; this needs someone to remember the new build input, and forgetting
# that fails the build loudly instead of quietly shipping gigabytes of worktree
# copies. Everything below is a path a build stage actually reads.
*

# Frontend build inputs - stage 1 runs `bun install` and `vite build`.
!frontend/package.json
!frontend/bun.lock
!frontend/.npmrc
!frontend/vite.config.ts
!frontend/scripts/inlang-settings.ts
!frontend/tsconfig.json
!frontend/messages
!frontend/src
!frontend/static
# The lockups the SPA inlines through the $brand alias (vite.config.ts).
!assets/brand/lockups

# Go build inputs - stage 2. Stage 1 reads service/internal/i18n/locales.json
# from here too: the list of languages lives in the Go module.
!service/go.mod
!service/go.sum
!service/cmd
!service/internal

# ...except the directory stage 1 writes and stage 2 copies from it.
service/internal/web/dist
