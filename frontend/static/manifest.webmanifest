{
	"id": "/",
	"name": "Rezepte",
	"short_name": "Rezepte",
	"description": "A self-hosted recipe manager for the people you cook with",
	"lang": "en",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"theme_color": "#f9e5cd",
	"background_color": "#f9e5cd",
	"icons": [
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png"
		},
		{
			"src": "/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Import",
			"url": "/import",
			"icons": [
				{
					"src": "/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "New recipe",
			"url": "/recipes/new",
			"icons": [
				{
					"src": "/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Favorites",
			"url": "/?favorites=true",
			"icons": [
				{
					"src": "/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		}
	],
	"share_target": {
		"action": "/import",
		"method": "GET",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url"
		}
	},
	"launch_handler": {
		"client_mode": "focus-existing"
	}
}
