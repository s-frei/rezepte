{
  "$defs": {
    "Author": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        }
      },
      "required": [
        "displayName"
      ],
      "type": "object"
    },
    "Book": {
      "additionalProperties": false,
      "properties": {
        "countDisplay": {
          "type": "string"
        },
        "date": {
          "format": "date",
          "type": "string"
        },
        "dateDisplay": {
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title",
        "date",
        "dateDisplay",
        "countDisplay"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "Data": {
      "additionalProperties": false,
      "properties": {
        "book": {
          "$ref": "#/$defs/Book"
        },
        "generatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "generator": {
          "$ref": "#/$defs/Generator"
        },
        "instance": {
          "$ref": "#/$defs/Instance"
        },
        "labels": {
          "$ref": "#/$defs/Labels"
        },
        "locale": {
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/Options"
        },
        "recipes": {
          "items": {
            "$ref": "#/$defs/Recipe"
          },
          "type": "array"
        },
        "schemaVersion": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "generator",
        "generatedAt",
        "locale",
        "options",
        "instance",
        "labels",
        "book",
        "recipes"
      ],
      "type": "object"
    },
    "Duration": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "string"
        },
        "minutes": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "minutes",
        "display"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "Focus": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Generator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "Group": {
      "additionalProperties": false,
      "properties": {
        "ingredients": {
          "items": {
            "$ref": "#/$defs/PDFIngredient"
          },
          "type": "array"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "ingredients"
      ],
      "type": "object"
    },
    "Instance": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "type": "boolean"
        },
        "product": {
          "description": "The product name for the credit line, never an operator's text",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "product",
        "url",
        "attribution"
      ],
      "type": "object"
    },
    "Labels": {
      "additionalProperties": false,
      "properties": {
        "addedBy": {
          "type": "string"
        },
        "contents": {
          "type": "string"
        },
        "continued": {
          "type": "string"
        },
        "cook": {
          "type": "string"
        },
        "ingredients": {
          "type": "string"
        },
        "nextPage": {
          "type": "string"
        },
        "openRecipe": {
          "type": "string"
        },
        "prep": {
          "type": "string"
        },
        "recipeFallback": {
          "description": "The file name of a recipe without a title",
          "type": "string"
        },
        "scaledFrom": {
          "type": "string"
        },
        "scaledFromShort": {
          "type": "string"
        },
        "servings": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "steps": {
          "type": "string"
        },
        "total": {
          "type": "string"
        }
      },
      "required": [
        "servings",
        "prep",
        "cook",
        "total",
        "ingredients",
        "steps",
        "source",
        "addedBy",
        "contents",
        "recipeFallback",
        "continued",
        "nextPage",
        "openRecipe",
        "scaledFrom",
        "scaledFromShort"
      ],
      "type": "object"
    },
    "Options": {
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "enum": [
            "single",
            "book",
            "zip"
          ],
          "type": "string"
        },
        "footer": {
          "description": "The QR code and the credit line; the source prints regardless",
          "type": "boolean"
        },
        "paper": {
          "enum": [
            "a4",
            "a5"
          ],
          "type": "string"
        },
        "photo": {
          "description": "Whether to show the photo; recipes[].photo is sent either way",
          "type": "boolean"
        }
      },
      "required": [
        "bundle",
        "paper",
        "photo",
        "footer"
      ],
      "type": "object"
    },
    "PDFIngredient": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "quantity",
        "unit",
        "name",
        "note",
        "display"
      ],
      "type": "object"
    },
    "PDFStep": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "format": "int64",
          "type": "integer"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "text",
        "segments"
      ],
      "type": "object"
    },
    "Photo": {
      "additionalProperties": false,
      "properties": {
        "focus": {
          "$ref": "#/$defs/Focus"
        },
        "height": {
          "format": "int64",
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "width": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "width",
        "height",
        "focus"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "QR": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "The code as an SVG without a quiet zone: leave four modules of white around it",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "path"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "string"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "value",
        "display"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "Recipe": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "$ref": "#/$defs/Author"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ingredientGroups": {
          "items": {
            "$ref": "#/$defs/Group"
          },
          "type": "array"
        },
        "photo": {
          "$ref": "#/$defs/Photo"
        },
        "qr": {
          "$ref": "#/$defs/QR"
        },
        "servings": {
          "$ref": "#/$defs/Servings"
        },
        "slug": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PDFStep"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "times": {
          "$ref": "#/$defs/Times"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "url",
        "title",
        "description",
        "tags",
        "servings",
        "times",
        "source",
        "author",
        "createdAt",
        "updatedAt",
        "photo",
        "qr",
        "ingredientGroups",
        "steps"
      ],
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "text",
            "ingredient",
            "time"
          ],
          "type": "string"
        },
        "minutes": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "amount",
        "minutes"
      ],
      "type": "object"
    },
    "Servings": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "string"
        },
        "original": {
          "format": "int64",
          "type": "integer"
        },
        "value": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "original",
        "display"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "description": "How the source prints: the name, else the host of the URL without a leading www.",
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "url",
        "display"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "Times": {
      "additionalProperties": false,
      "properties": {
        "cook": {
          "$ref": "#/$defs/Duration"
        },
        "prep": {
          "$ref": "#/$defs/Duration"
        },
        "total": {
          "$ref": "#/$defs/Duration"
        }
      },
      "required": [
        "prep",
        "cook",
        "total"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/Data",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
