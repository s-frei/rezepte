[
  {
    "title": "Königsberger Klopse",
    "description": "Klassische ostpreußische Fleischklopse in einer cremigen Sauce mit Kapern und Zitrone.",
    "servings": 4,
    "prepMinutes": 30,
    "cookMinutes": 30,
    "sourceUrl": null,
    "tags": ["klassiker", "fleisch"],
    "ingredientGroups": [
      {
        "name": "Klopse",
        "ingredients": [
          { "quantity": 500, "unit": "g", "name": "Rinderhackfleisch", "note": null },
          { "quantity": 1, "unit": "Stück", "name": "Zwiebel", "note": null },
          { "quantity": 1, "unit": "Stück", "name": "Ei", "note": null },
          { "quantity": 2, "unit": "Stück", "name": "Toastbrot", "note": "eingeweicht, ausgedrückt" },
          { "quantity": 1, "unit": "EL", "name": "Senf", "note": null },
          { "quantity": 1, "unit": "Prise", "name": "Salz", "note": null },
          { "quantity": 1, "unit": "Prise", "name": "Pfeffer", "note": null }
        ]
      },
      {
        "name": "Kapernsauce",
        "ingredients": [
          { "quantity": 30, "unit": "g", "name": "Butter", "note": null },
          { "quantity": 30, "unit": "g", "name": "Mehl", "note": null },
          { "quantity": 500, "unit": "ml", "name": "Rinderbrühe", "note": null },
          { "quantity": 100, "unit": "ml", "name": "Sahne", "note": null },
          { "quantity": 3, "unit": "EL", "name": "Kapern", "note": null },
          { "quantity": 1, "unit": "EL", "name": "Zitronensaft", "note": null },
          { "quantity": 1, "unit": "Prise", "name": "Salz", "note": null }
        ]
      }
    ],
    "steps": [
      { "text": "Zwiebel fein würfeln und mit Hackfleisch, Ei, ausgedrücktem Toastbrot, Senf, Salz und Pfeffer vermengen.", "references": [{ "word": "Zwiebel", "groupName": "Klopse", "ingredientName": "Zwiebel" }, { "word": "Hackfleisch", "groupName": "Klopse", "ingredientName": "Rinderhackfleisch" }, { "word": "Ei", "groupName": "Klopse", "ingredientName": "Ei" }, { "word": "Toastbrot", "groupName": "Klopse", "ingredientName": "Toastbrot" }, { "word": "Senf", "groupName": "Klopse", "ingredientName": "Senf" }, { "word": "Pfeffer", "groupName": "Klopse", "ingredientName": "Pfeffer" }] },
      { "text": "Aus der Masse mit angefeuchteten Händen Klopse formen.", "references": [] },
      { "text": "Brühe in einem großen Topf erhitzen und die Klopse darin 15 Minuten gar ziehen lassen.", "references": [{ "word": "Brühe", "groupName": "Kapernsauce", "ingredientName": "Rinderbrühe" }] },
      { "text": "Klopse herausnehmen und die Brühe für die Sauce beiseitestellen.", "references": [{ "word": "Brühe", "groupName": "Kapernsauce", "ingredientName": "Rinderbrühe" }] },
      { "text": "Butter schmelzen, Mehl einrühren und mit der Brühe unter Rühren zu einer Sauce aufkochen.", "references": [{ "word": "Butter", "groupName": "Kapernsauce", "ingredientName": "Butter" }, { "word": "Mehl", "groupName": "Kapernsauce", "ingredientName": "Mehl" }, { "word": "Brühe", "groupName": "Kapernsauce", "ingredientName": "Rinderbrühe" }] },
      { "text": "Sahne, Kapern und Zitronensaft einrühren, mit Salz abschmecken und die Klopse darin erwärmen.", "references": [{ "word": "Sahne", "groupName": "Kapernsauce", "ingredientName": "Sahne" }, { "word": "Kapern", "groupName": "Kapernsauce", "ingredientName": "Kapern" }, { "word": "Zitronensaft", "groupName": "Kapernsauce", "ingredientName": "Zitronensaft" }] }
    ]
  },
  {
    "title": "Rinderrouladen",
    "description": "Rinderrouladen mit Senf, Speck und Gewürzgurken gefüllt und in dunkler Sauce geschmort.",
    "servings": 4,
    "prepMinutes": 30,
    "cookMinutes": 100,
    "sourceUrl": null,
    "tags": ["klassiker", "fleisch", "schmoren"],
    "ingredientGroups": [
      {
        "name": "Rouladen",
        "ingredients": [
          { "quantity": 4, "unit": "Stück", "name": "Rinderrouladen", "note": null },
          { "quantity": 4, "unit": "TL", "name": "Senf", "note": null },
          { "quantity": 4, "unit": "Stück", "name": "Speck", "note": null },
          { "quantity": 1, "unit": "Stück", "name": "Zwiebel", "note": null },
          { "quantity": 2, "unit": "Stück", "name": "Gewürzgurken", "note": null },
          { "quantity": 1, "unit": "Prise", "name": "Salz", "note": null },
          { "quantity": 1, "unit": "Prise", "name": "Pfeffer", "note": null }
        ]
      },
      {
        "name": "Sauce",
        "ingredients": [
          { "quantity": 2, "unit": "EL", "name": "Tomatenmark", "note": null },
          { "quantity": 500, "unit": "ml", "name": "Rinderbrühe", "note": null },
          { "quantity": 1, "unit": "Stück", "name": "Möhre", "note": null },
          { "quantity": 1, "unit": "Stück", "name": "Zwiebel", "note": null },
          { "quantity": 2, "unit": "EL", "name": "Mehl", "note": "zum Andicken" },
          { "quantity": 1, "unit": "Prise", "name": "Salz", "note": null }
        ]
      }
    ],
    "steps": [
      { "text": "Rouladen flach auslegen, mit Senf bestreichen, mit Speck, Zwiebel- und Gurkenstreifen belegen, salzen und pfeffern.", "references": [{ "word": "Rouladen", "groupName": "Rouladen", "ingredientName": "Rinderrouladen" }, { "word": "Senf", "groupName": "Rouladen", "ingredientName": "Senf" }, { "word": "Speck", "groupName": "Rouladen", "ingredientName": "Speck" }, { "word": "Gurkenstreifen", "groupName": "Rouladen", "ingredientName": "Gewürzgurken" }] },
      { "text": "Rouladen aufrollen und mit Rouladennadeln oder Küchengarn feststecken.", "references": [{ "word": "Rouladen", "groupName": "Rouladen", "ingredientName": "Rinderrouladen" }] },
      { "text": "In einem Bräter rundum scharf anbraten.", "references": [] },
      { "text": "Möhre und Zwiebel würfeln, zugeben und kurz mitrösten, Tomatenmark einrühren.", "references": [{ "word": "Möhre", "groupName": "Sauce", "ingredientName": "Möhre" }, { "word": "Tomatenmark", "groupName": "Sauce", "ingredientName": "Tomatenmark" }] },
      { "text": "Mit Brühe ablöschen und die Rouladen zugedeckt bei kleiner Hitze etwa 90 Minuten schmoren.", "references": [{ "word": "Brühe", "groupName": "Sauce", "ingredientName": "Rinderbrühe" }, { "word": "Rouladen", "groupName": "Rouladen", "ingredientName": "Rinderrouladen" }] },
      { "text": "Rouladen herausnehmen, Sauce mit Mehl binden, abschmecken und die Rouladen darin servieren.", "references": [{ "word": "Rouladen", "groupName": "Rouladen", "ingredientName": "Rinderrouladen" }, { "word": "Mehl", "groupName": "Sauce", "ingredientName": "Mehl" }] }
    ]
  },
  {
    "title": "Sauerbraten",
    "description": "Traditionell gebeizter Rinderbraten, lange geschmort und mit einer süßsauren Sauce serviert.",
    "servings": 4,
    "prepMinutes": 30,
    "cookMinutes": 150,
    "sourceUrl": null,
    "tags": ["klassiker", "fleisch", "schmoren"],
    "ingredientGroups": [
      {
        "name": "Beize",
        "ingredients": [
          { "quantity": 500, "unit": "ml", "name": "Rotweinessig", "note": null },
          { "quantity": 500, "unit": "ml", "name": "Wasser", "note": null },
          { "quantity": 1, "unit": "Stück", "name": "Zwiebel", "note": null },
          { "quantity": 1, "unit": "Stück", "name": "Möhre", "note": null },
          { "quantity": 2, "unit": "Stück", "name": "Lorbeerblätter", "note": null },
          { "quantity": 1, "unit": "TL", "name": "Pfefferkörner", "note": null },
          { "quantity": 1, "unit": "Prise", "name": "Salz", "note": null }
        ]
      },
      {
        "name": "Braten",
        "ingredients": [
          { "quantity": 1.5, "unit": "kg", "name": "Rinderbraten", "note": null },
          { "quantity": 2, "unit": "EL", "name": "Öl", "note": null },
          { "quantity": 2, "unit": "EL", "name": "Tomatenmark", "note": null },
          { "quantity": 50, "unit": "g", "name": "Rosinen", "note": null },
          { "quantity": 100, "unit": "g", "name": "Sahne", "note": "zum Binden" },
          { "quantity": 1, "unit": "Prise", "name": "Salz", "note": null }
        ]
      }
    ],
    "steps": [
      { "text": "Rotweinessig, Wasser, Zwiebel, Möhre, Lorbeer, Pfefferkörner und Salz aufkochen und abkühlen lassen.", "references": [{ "word": "Rotweinessig", "groupName": "Beize", "ingredientName": "Rotweinessig" }, { "word": "Wasser", "groupName": "Beize", "ingredientName": "Wasser" }, { "word": "Zwiebel", "groupName": "Beize", "ingredientName": "Zwiebel" }, { "word": "Möhre", "groupName": "Beize", "ingredientName": "Möhre" }, { "word": "Pfefferkörner", "groupName": "Beize", "ingredientName": "Pfefferkörner" }, { "word": "Lorbeer", "groupName": "Beize", "ingredientName": "Lorbeerblätter" }] },
      { "text": "Rindfleisch in die Beize legen und 3 Tage kühl ziehen lassen, dabei gelegentlich wenden.", "references": [{ "word": "Rindfleisch", "groupName": "Braten", "ingredientName": "Rinderbraten" }] },
      { "text": "Fleisch abtropfen lassen und trocken tupfen, die Beize aufheben.", "references": [{ "word": "Fleisch", "groupName": "Braten", "ingredientName": "Rinderbraten" }] },
      { "text": "Fleisch in Öl rundum scharf anbraten.", "references": [{ "word": "Öl", "groupName": "Braten", "ingredientName": "Öl" }, { "word": "Fleisch", "groupName": "Braten", "ingredientName": "Rinderbraten" }] },
      { "text": "Tomatenmark zugeben, kurz mitrösten und mit der Beize auffüllen.", "references": [{ "word": "Tomatenmark", "groupName": "Braten", "ingredientName": "Tomatenmark" }] },
      { "text": "Zugedeckt bei kleiner Hitze etwa 2,5 Stunden schmoren, bis das Fleisch weich ist.", "references": [{ "word": "Fleisch", "groupName": "Braten", "ingredientName": "Rinderbraten" }] },
      { "text": "Fleisch herausnehmen, Sauce mit Rosinen und Sahne binden, abschmecken und in Scheiben aufschneiden.", "references": [{ "word": "Rosinen", "groupName": "Braten", "ingredientName": "Rosinen" }, { "word": "Sahne", "groupName": "Braten", "ingredientName": "Sahne" }, { "word": "Fleisch", "groupName": "Braten", "ingredientName": "Rinderbraten" }] }
    ]
  },
  {
    "title": "Käsespätzle",
    "description": "Schwäbische Spätzle mit reichlich Bergkäse überbacken und mit knusprigen Röstzwiebeln serviert.",
    "servings": 4,
    "prepMinutes": 20,
    "cookMinutes": 20,
    "sourceUrl": null,
    "tags": ["vegetarisch", "schwäbisch"],
    "ingredientGroups": [
      {
        "name": "Spätzle",
        "ingredients": [
          { "quantity": 400, "unit": "g", "name": "Mehl", "note": null },
          { "quantity": 4, "unit": "Stück", "name": "Ei", "note": null },
          { "quantity": 200, "unit": "ml", "name": "Wasser", "note": null },
          { "quantity": 1, "unit": "TL", "name": "Salz", "note": null },
          { "quantity": 200, "unit": "g", "name": "Bergkäse", "note": "gerieben" }
        ]
      },
      {
        "name": "Röstzwiebeln",
        "ingredients": [
          { "quantity": 2, "unit": "Stück", "name": "Zwiebeln", "note": null },
          { "quantity": 2, "unit": "EL", "name": "Butter", "note": null },
          { "quantity": 1, "unit": "Prise", "name": "Salz", "note": null }
        ]
      }
    ],
    "steps": [
      { "text": "Mehl, Eier, Wasser und Salz zu einem zähen Teig verrühren, bis er Blasen wirft.", "references": [{ "word": "Mehl", "groupName": "Spätzle", "ingredientName": "Mehl" }, { "word": "Wasser", "groupName": "Spätzle", "ingredientName": "Wasser" }, { "word": "Eier", "groupName": "Spätzle", "ingredientName": "Ei" }] },
      { "text": "Teig durch eine Spätzlepresse oder vom Brett ins kochende Salzwasser schaben.", "references": [] },
      { "text": "Spätzle garziehen lassen, bis sie an die Oberfläche steigen, abschöpfen.", "references": [] },
      { "text": "Zwiebeln in Ringe schneiden und in Butter goldbraun braten.", "references": [{ "word": "Zwiebeln", "groupName": "Röstzwiebeln", "ingredientName": "Zwiebeln" }, { "word": "Butter", "groupName": "Röstzwiebeln", "ingredientName": "Butter" }] },
      { "text": "Spätzle lagenweise mit Käse in eine Pfanne schichten, schmelzen lassen und mit Röstzwiebeln servieren.", "references": [{ "word": "Käse", "groupName": "Spätzle", "ingredientName": "Bergkäse" }] }
    ]
  },
  {
