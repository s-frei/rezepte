    "steps": [
      { "text": "Zwiebel fein würfeln und mit Hackfleisch, Ei, ausgedrücktem Toastbrot, Senf, Salz und Pfeffer vermengen.", "references": [{ "word": "Zwiebel", "groupName": "Klopse", "ingredientName": "Zwiebel" }, { "word": "Hackfleisch", "groupName": "Klopse", "ingredientName": "Rinderhackfleisch" }, { "word": "Ei", "groupName": "Klopse", "ingredientName": "Ei" }, { "word": "Toastbrot", "groupName": "Klopse", "ingredientName": "Toastbrot" }, { "word": "Senf", "groupName": "Klopse", "ingredientName": "Senf" }, { "word": "Pfeffer", "groupName": "Klopse", "ingredientName": "Pfeffer" }], "times": [] },
      { "text": "Aus der Masse mit angefeuchteten Händen Klopse formen.", "references": [], "times": [] },
      { "text": "Brühe in einem großen Topf erhitzen und die Klopse darin 15 Minuten gar ziehen lassen.", "references": [{ "word": "Brühe", "groupName": "Kapernsauce", "ingredientName": "Rinderbrühe" }], "times": [{ "phrase": "15 Minuten", "seconds": 900 }] },
      { "text": "Klopse herausnehmen und die Brühe für die Sauce beiseitestellen.", "references": [{ "word": "Brühe", "groupName": "Kapernsauce", "ingredientName": "Rinderbrühe" }], "times": [] },
      { "text": "Butter schmelzen, Mehl einrühren und mit der Brühe unter Rühren zu einer Sauce aufkochen.", "references": [{ "word": "Butter", "groupName": "Kapernsauce", "ingredientName": "Butter" }, { "word": "Mehl", "groupName": "Kapernsauce", "ingredientName": "Mehl" }, { "word": "Brühe", "groupName": "Kapernsauce", "ingredientName": "Rinderbrühe" }], "times": [] },
      { "text": "Sahne, Kapern und Zitronensaft einrühren, mit Salz abschmecken und die Klopse darin erwärmen.", "references": [{ "word": "Sahne", "groupName": "Kapernsauce", "ingredientName": "Sahne" }, { "word": "Kapern", "groupName": "Kapernsauce", "ingredientName": "Kapern" }, { "word": "Zitronensaft", "groupName": "Kapernsauce", "ingredientName": "Zitronensaft" }], "times": [] }
    ]
