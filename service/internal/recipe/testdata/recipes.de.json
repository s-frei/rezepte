    "steps": [
      { "text": "Kartoffeln kochen, abkühlen lassen, pellen und in Scheiben schneiden.", "references": [{ "word": "Kartoffeln", "groupName": null, "ingredientName": "Kartoffeln" }] },
      { "text": "Schnitzel salzen und pfeffern, dann in Mehl, verquirltem Ei und Semmelbröseln panieren.", "references": [{ "word": "Schnitzel", "groupName": null, "ingredientName": "Schweineschnitzel" }, { "word": "Mehl", "groupName": null, "ingredientName": "Mehl" }, { "word": "Ei", "groupName": null, "ingredientName": "Ei" }, { "word": "Semmelbröseln", "groupName": null, "ingredientName": "Semmelbrösel" }] },
      { "text": "Schnitzel in Öl von beiden Seiten goldbraun braten.", "references": [{ "word": "Schnitzel", "groupName": null, "ingredientName": "Schweineschnitzel" }, { "word": "Öl", "groupName": null, "ingredientName": "Öl" }] },
