  {
    "title": "Beef and Ale Stew",
    "description": "Beef chunks slow-braised in ale with root vegetables until meltingly tender.",
    "servings": 4,
    "prepMinutes": 20,
    "cookMinutes": 120,
    "sourceUrl": "https://example.com/beef-and-ale-stew",
    "sourceName": "Sunday Stews",
    "tags": ["classic", "meat", "stew"],
    "ingredientGroups": [
      {
        "name": "Marinade",
        "ingredients": [
          { "quantity": 500, "unit": "ml", "name": "brown ale", "note": null },
          { "quantity": 1, "unit": "tbsp", "name": "malt vinegar", "note": null },
          { "quantity": 2, "unit": "tbsp", "name": "Worcestershire sauce", "note": null },
          { "quantity": 3, "unit": "cloves", "name": "garlic", "note": "crushed" },
          { "quantity": 1, "unit": null, "name": "onion", "note": "sliced" },
          { "quantity": 2, "unit": null, "name": "bay leaves", "note": null },
          { "quantity": 4, "unit": "sprigs", "name": "thyme", "note": null },
          { "quantity": 1, "unit": "sprig", "name": "rosemary", "note": null },
          { "quantity": 1, "unit": "tsp", "name": "black peppercorns", "note": null },
          { "quantity": 4, "unit": null, "name": "juniper berries", "note": "lightly crushed" },
          { "quantity": 1, "unit": "tbsp", "name": "brown sugar", "note": null },
          { "quantity": 1, "unit": "tsp", "name": "English mustard", "note": null },
          { "quantity": 1, "unit": "tsp", "name": "salt", "note": null }
        ]
      },
      {
        "name": "Stew",
        "ingredients": [
          { "quantity": 1, "unit": "kg", "name": "stewing beef", "note": "chuck, in 4 cm cubes" },
          { "quantity": 3, "unit": "tbsp", "name": "plain flour", "note": null },
          { "quantity": 3, "unit": "tbsp", "name": "vegetable oil", "note": null },
          { "quantity": 150, "unit": "g", "name": "smoked bacon lardons", "note": null },
          { "quantity": 3, "unit": null, "name": "carrots", "note": "in chunks" },
          { "quantity": 2, "unit": "sticks", "name": "celery", "note": "sliced" },
          { "quantity": 1, "unit": "tbsp", "name": "tomato puree", "note": null },
          { "quantity": 300, "unit": "ml", "name": "beef stock", "note": null }
        ]
      },
      {
        "name": "To finish",
        "ingredients": [
          { "quantity": 30, "unit": "g", "name": "butter", "note": null },
          { "quantity": 250, "unit": "g", "name": "cremini mushrooms", "note": "halved" },
          { "quantity": 200, "unit": "g", "name": "pearl onions", "note": "peeled" },
          { "quantity": 1, "unit": "tbsp", "name": "red currant jelly", "note": null },
          { "quantity": 1, "unit": "bunch", "name": "flat-leaf parsley", "note": "chopped" },
          { "quantity": 1, "unit": "pinch", "name": "salt", "note": null },
          { "quantity": 1, "unit": "pinch", "name": "pepper", "note": null }
        ]
      }
    ],
    "steps": [
      { "text": "For the marinade, whisk the brown ale with the malt vinegar, Worcestershire sauce, brown sugar, mustard and salt until the sugar dissolves.", "references": [{ "word": "brown ale", "groupName": "Marinade", "ingredientName": "brown ale" }, { "word": "malt vinegar", "groupName": "Marinade", "ingredientName": "malt vinegar" }, { "word": "Worcestershire sauce", "groupName": "Marinade", "ingredientName": "Worcestershire sauce" }, { "word": "brown sugar", "groupName": "Marinade", "ingredientName": "brown sugar" }, { "word": "mustard", "groupName": "Marinade", "ingredientName": "English mustard" }, { "word": "salt", "groupName": "Marinade", "ingredientName": "salt" }], "times": [] },
      { "text": "Add the garlic, onion, bay leaves, thyme, rosemary, peppercorns and juniper berries.", "references": [{ "word": "garlic", "groupName": "Marinade", "ingredientName": "garlic" }, { "word": "onion", "groupName": "Marinade", "ingredientName": "onion" }, { "word": "bay leaves", "groupName": "Marinade", "ingredientName": "bay leaves" }, { "word": "thyme", "groupName": "Marinade", "ingredientName": "thyme" }, { "word": "rosemary", "groupName": "Marinade", "ingredientName": "rosemary" }, { "word": "peppercorns", "groupName": "Marinade", "ingredientName": "black peppercorns" }, { "word": "juniper berries", "groupName": "Marinade", "ingredientName": "juniper berries" }], "times": [] },
      { "text": "Put the beef in a bowl, pour over the marinade, cover and leave in the fridge overnight, turning the pieces once.", "references": [{ "word": "beef", "groupName": "Stew", "ingredientName": "stewing beef" }], "times": [] },
      { "text": "Lift the beef out, pat it dry with paper towels and strain the marinade, keeping the liquid and the aromatics apart.", "references": [{ "word": "beef", "groupName": "Stew", "ingredientName": "stewing beef" }], "times": [] },
      { "text": "Toss the beef in the flour until every piece is lightly coated.", "references": [{ "word": "beef", "groupName": "Stew", "ingredientName": "stewing beef" }, { "word": "flour", "groupName": "Stew", "ingredientName": "plain flour" }], "times": [] },
      { "text": "Heat the oil in a Dutch oven and brown the beef in batches over high heat, then set it aside.", "references": [{ "word": "oil", "groupName": "Stew", "ingredientName": "vegetable oil" }, { "word": "beef", "groupName": "Stew", "ingredientName": "stewing beef" }], "times": [] },
      { "text": "Fry the bacon lardons in the same pot for 5 minutes until crisp.", "references": [{ "word": "bacon lardons", "groupName": "Stew", "ingredientName": "smoked bacon lardons" }], "times": [{ "phrase": "5 minutes", "seconds": 300 }] },
      { "text": "Add the carrots, celery and the strained aromatics and cook for 8 minutes until they start to color, then stir in the tomato puree.", "references": [{ "word": "carrots", "groupName": "Stew", "ingredientName": "carrots" }, { "word": "celery", "groupName": "Stew", "ingredientName": "celery" }, { "word": "tomato puree", "groupName": "Stew", "ingredientName": "tomato puree" }], "times": [{ "phrase": "8 minutes", "seconds": 480 }] },
      { "text": "Return the beef and any juices to the pot.", "references": [{ "word": "beef", "groupName": "Stew", "ingredientName": "stewing beef" }], "times": [] },
      { "text": "Pour the marinade over the beef, scraping up every browned bit from the bottom of the pot with a wooden spoon, and bring it to a gentle boil so the alcohol cooks off. Add the stock until the meat is just covered, then lay a sheet of parchment paper on the surface and put the lid on. Braise in the oven at 150 °C for about 2 hours, checking every 30 minutes: give the stew a careful stir, push any pieces that have surfaced back under the liquid and top up with a splash of stock or water if it has reduced below the meat. Keep the heat low enough that the liquid only trembles; a hard boil toughens the beef and turns the ale bitter. The stew is ready when a cube of beef breaks apart under the gentle pressure of a spoon. If it still resists, give it another 20 to 30 minutes and test again. The sauce should coat the back of a spoon; if it is too thin, leave the lid off for the last half hour so it can reduce.", "references": [{ "word": "beef", "groupName": "Stew", "ingredientName": "stewing beef" }, { "word": "stock", "groupName": "Stew", "ingredientName": "beef stock" }], "times": [{ "phrase": "2 hours", "seconds": 7200 }, { "phrase": "30 minutes", "seconds": 1800 }, { "phrase": "20 to 30 minutes", "seconds": 1200, "maxSeconds": 1800 }] },
      { "text": "Shortly before the stew is done, melt the butter in a skillet and fry the mushrooms and pearl onions for 10 minutes until golden.", "references": [{ "word": "butter", "groupName": "To finish", "ingredientName": "butter" }, { "word": "mushrooms", "groupName": "To finish", "ingredientName": "cremini mushrooms" }, { "word": "pearl onions", "groupName": "To finish", "ingredientName": "pearl onions" }], "times": [{ "phrase": "10 minutes", "seconds": 600 }] },
      { "text": "Stir the mushrooms and onions into the stew with the red currant jelly.", "references": [{ "word": "mushrooms", "groupName": "To finish", "ingredientName": "cremini mushrooms" }, { "word": "onions", "groupName": "To finish", "ingredientName": "pearl onions" }, { "word": "red currant jelly", "groupName": "To finish", "ingredientName": "red currant jelly" }], "times": [] },
      { "text": "Simmer uncovered for 10 minutes so the flavors come together.", "references": [], "times": [{ "phrase": "10 minutes", "seconds": 600 }] },
      { "text": "Season with salt and pepper and fish out the bay leaves and thyme stalks.", "references": [{ "word": "salt", "groupName": "To finish", "ingredientName": "salt" }, { "word": "pepper", "groupName": "To finish", "ingredientName": "pepper" }], "times": [] },
      { "text": "Scatter over the parsley and serve with mashed potatoes or crusty bread.", "references": [{ "word": "parsley", "groupName": "To finish", "ingredientName": "flat-leaf parsley" }], "times": [] }
    ]
  },
