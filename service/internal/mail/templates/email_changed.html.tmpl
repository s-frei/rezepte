{{define "content"}}<p style="font-family:Georgia,'Times New Roman',serif;font-size:22px;margin:0 0 14px;">{{t (printf "%s_heading" .Data.Prefix)}}</p>
  <p style="font-size:16px;line-height:1.6;margin:0 0 14px;">{{t .Data.Body "username" .Data.Username "admin" .Data.Admin "address" .Data.Address "at" (datetime .Data.At)}}</p>
  <p style="font-size:16px;line-height:1.6;margin:0;">{{if .Data.Admin}}{{t "mail_email_changed_not_you_admin" "admin" .Data.Admin}}{{else}}{{t "mail_email_changed_not_you"}}{{end}}</p>{{end}}
{{define "footer"}}{{template "note" (t "mail_security_notice")}}{{end}}
