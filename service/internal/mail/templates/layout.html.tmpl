<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Subject}}</title>
<style>
  @media (prefers-color-scheme: dark) {
    .page { background: #1c1612 !important; }
    .sheet { background: #26201a !important; color: #f3ebe0 !important; }
    .mark, .link { color: #d97a2b !important; }
    .btn { background: #d97a2b !important; }
    .btn a { color: #1c1612 !important; }
    .muted { color: #a8998a !important; }
    .rule { border-color: #3b322a !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#f4ede2;" class="page">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4ede2;" class="page">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background:#fdf9f2;border-radius:6px;color:#2b2118;" class="sheet">
<tr><td style="padding:44px 48px 36px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <div class="mark" style="font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:26px;color:#7c3d0a;">Rezepte</div>
  <div class="rule" style="border-bottom:2px dotted #e3d7c3;margin:14px 0 30px;"></div>
  {{if .Greeting}}<p style="font-family:Georgia,'Times New Roman',serif;font-size:22px;margin:0 0 14px;">{{.Greeting}}</p>{{end}}
  <p style="font-size:16px;line-height:1.6;margin:0 0 28px;">{{.Body}}</p>
  {{if .Button}}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td class="btn" style="border-radius:9999px;background:#b45309;">
    <a href="{{.URL}}" style="display:inline-block;padding:14px 28px;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:9999px;">{{.Button}}</a>
  </td></tr></table>
  {{if .Validity}}<p class="muted" style="font-size:13px;line-height:1.55;color:#756554;margin:22px 0 0;">{{.Validity}}</p>{{end}}
  <div class="rule" style="border-bottom:2px dotted #e3d7c3;margin:34px 0 18px;"></div>
  <p class="muted" style="font-size:13px;line-height:1.55;color:#756554;margin:0;">{{.Fallback}}<br><a class="link" href="{{.URL}}" style="color:#b45309;word-break:break-all;">{{.URL}}</a></p>
  {{end}}
  {{if .Footer}}<p class="muted" style="font-size:13px;line-height:1.55;color:#756554;margin:14px 0 0;">{{.Footer}}</p>{{end}}
</td></tr></table>
</td></tr></table>
</body>
</html>
