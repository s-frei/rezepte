{{define "content"}}<p style="font-family:Georgia,'Times New Roman',serif;font-size:22px;margin:0 0 20px;">{{t (printf "mail_%s_invite_heading" .Data.Kind) "name" .Data.Name .Data.Kind .Data.Title}}</p>
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 28px;"><tr>
    <td valign="middle" style="padding:0 12px 0 0;">{{template "circle" (dict "avatar" .Data.Avatar "initial" .Data.Initial "bg" .Data.Bg "fg" .Data.Fg "size" 36 "font" 16)}}</td>
    <td valign="middle" style="font-size:16px;line-height:1.6;">{{t (printf "mail_%s_invite_body" .Data.Kind)}}</td>
  </tr></table>
  {{template "button" (dict "text" (t (printf "mail_%s_invite_button" .Data.Kind)) "url" .Data.URL)}}
  {{template "fallback" .Data.URL}}{{end}}
{{define "footer"}}{{template "note" (t (printf "mail_%s_invite_reason" .Data.Kind))}}
  {{template "unsubscribe" (dict "links" .Unsubscribe "kind" (printf "mail_unsubscribe_kind_%s_invite" .Data.Kind) "group" "mail_unsubscribe_group_household")}}{{end}}
