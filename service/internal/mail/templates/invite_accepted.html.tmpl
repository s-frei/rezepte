{{define "content"}}<p style="font-family:Georgia,'Times New Roman',serif;font-size:22px;margin:0 0 14px;">{{t "mail_invite_accepted_heading" "name" .Data.Name}}</p>
  <p style="font-size:16px;line-height:1.6;margin:0 0 28px;">{{t "mail_invite_accepted_body" "name" .Data.Name "username" .Data.Username}}</p>
  {{template "button" (dict "text" (t "mail_invite_accepted_button") "url" .Data.URL)}}
  {{template "fallback" .Data.URL}}{{end}}
{{define "footer"}}{{template "note" (t "mail_invite_accepted_reason")}}
  {{template "unsubscribe" (dict "links" .Unsubscribe "kind" "mail_unsubscribe_kind_invite_accepted" "group" "mail_unsubscribe_group_admin")}}{{end}}
