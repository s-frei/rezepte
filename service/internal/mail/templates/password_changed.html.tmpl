{{define "content"}}<p style="font-family:Georgia,'Times New Roman',serif;font-size:22px;margin:0 0 14px;">{{t (printf "%s_heading" .Data.Prefix)}}</p>
  <p style="font-size:16px;line-height:1.6;margin:0 0 14px;">{{t (printf "%s_body_%s" .Data.Prefix .Data.Origin) "username" .Data.Username "admin" .Data.Admin "at" (datetime .Data.At)}}</p>
  {{if .Data.Owner}}<p style="font-size:16px;line-height:1.6;margin:0;">{{command (t "mail_password_changed_not_you_owner")}}</p>{{else}}<p style="font-size:16px;line-height:1.6;margin:0 0 28px;">{{if .Data.Admin}}{{t "mail_password_changed_not_you_admin" "admin" .Data.Admin}}{{else}}{{t "mail_password_changed_not_you"}}{{end}}</p>
  {{template "button" (dict "text" (t "mail_password_changed_button") "url" .Data.URL)}}
  {{template "fallback" .Data.URL}}{{end}}{{end}}
{{define "footer"}}{{template "note" (t "mail_security_notice")}}{{end}}
