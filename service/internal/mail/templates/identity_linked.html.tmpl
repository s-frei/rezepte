{{define "content"}}<p style="font-family:Georgia,'Times New Roman',serif;font-size:22px;margin:0 0 14px;">{{t "mail_identity_linked_heading"}}</p>
  <p style="font-size:16px;line-height:1.6;margin:0 0 14px;">{{t (printf "mail_identity_linked_body_%s" .Data.Origin) "username" .Data.Username "admin" .Data.Admin "provider" .Data.Provider "at" (datetime .Data.At)}}</p>
  <p style="font-size:16px;line-height:1.6;margin:0;">{{if .Data.Owner}}{{command (t "mail_identity_linked_not_you_owner")}}{{else if .Data.Admin}}{{t "mail_identity_linked_not_you_admin" "admin" .Data.Admin}}{{else}}{{t "mail_identity_linked_not_you"}}{{end}}</p>{{end}}
{{define "footer"}}{{template "note" (t "mail_security_notice")}}{{end}}
