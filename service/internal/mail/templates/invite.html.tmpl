{{define "content"}}<p style="font-family:Georgia,'Times New Roman',serif;font-size:22px;margin:0 0 14px;">{{t "mail_invite_greeting" "name" .Data.Name}}</p>
  <p style="font-size:16px;line-height:1.6;margin:0 0 28px;">{{t (printf "%s_body" .Data.Prefix) "inviter" .Data.Inviter}}</p>
  {{template "button" (dict "text" (t (printf "%s_button" .Data.Prefix)) "url" .Data.URL)}}
  {{template "validity" (t "mail_invite_validity")}}
  {{template "fallback" .Data.URL}}{{end}}
{{define "footer"}}{{template "note" (t "mail_invite_ignore" "inviter" .Data.Inviter)}}{{end}}
