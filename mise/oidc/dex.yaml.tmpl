# Rendered into .oidc/dex.yaml by `mise run oidc:up` (mise/tasks/oidc/up.sh),
# which substitutes the ${…} placeholders with sed - no envsubst dependency.
# Do not edit .oidc/dex.yaml directly, it is gitignored and regenerated on
# every oidc:up.
#
# The bcrypt hashes below are anna1234 and ben1234 (the repository's
# development-credential rule), generated once with a throwaway
# `go run` of golang.org/x/crypto/bcrypt and written in as literals, so
# starting Dex needs no hashing step at runtime.
issuer: http://localhost:${RZP_DEX_PORT}/dex
storage:
  type: memory
web:
  http: 0.0.0.0:5556
oauth2:
  skipApprovalScreen: true
enablePasswordDB: true
staticClients:
  - id: rezepte
    secret: rezepte-test-secret
    name: Rezepte
    redirectURIs:
      - http://localhost:${RZP_BACKEND_PORT}/api/v1/auth/oidc/callback
      - http://localhost:${RZP_DEMO_PORT}/api/v1/auth/oidc/callback
      - http://localhost:${RZP_E2E_PORT}/api/v1/auth/oidc/callback
      - http://localhost:${RZP_SCREENSHOTS_PORT}/api/v1/auth/oidc/callback
staticPasswords:
  - email: anna@example.org
    hash: "$2a$10$h6ZC361CxuY.PGpDYwX3IeoWGsVLPcAwTSdywwjarsbEe.urrMqMy"
    username: anna
    userID: anna
  - email: ben@example.org
    hash: "$2a$10$8Efkh8Jl8hSl2XQCgdPL8eAqC/iON4NqGyUN/ZwrtExyxswCr69ke"
    username: ben
    userID: ben
