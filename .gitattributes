# Demo photo and avatar originals, exactly as generated; the build embeds smaller copies.
assets/demo-photos/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/demo-avatars/**/*.jpg filter=lfs diff=lfs merge=lfs -text
# The mascot and its scenes, exactly as generated (the mascot also cut out); generators derive what the sites load.
assets/brand/mascot/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/brand/mascot/*.png filter=lfs diff=lfs merge=lfs -text
assets/brand/scenes/*.jpg filter=lfs diff=lfs merge=lfs -text
